۱۱. پروژه چهارم: اندازه‌گیری فاصله با حسگر HC-SR04

هدف پروژه

در این پروژه با یک حسگر فراصوت آشنا می‌شویم و فاصله یک مانع را اندازه‌گیری می‌کنیم.

قطعات مورد نیاز

- Arduino Uno
- حسگر HC-SR04
- سیم اتصال

پایه‌های حسگر

پایه| کاربرد
VCC| تغذیه ۵ ولت
TRIG| ارسال پالس تحریک
ECHO| دریافت پالس بازگشتی
GND| زمین

نحوه اتصال

- VCC به 5V
- GND به GND
- TRIG به D9
- ECHO به D10

کد برنامه

const int trigPin = 9;
const int echoPin = 10;

void setup() {

  pinMode(trigPin, OUTPUT);

  pinMode(echoPin, INPUT);

  Serial.begin(9600);

}

void loop() {

  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);

  digitalWrite(trigPin, LOW);

  unsigned long duration = pulseIn(echoPin, HIGH, 30000);

  if (duration == 0) {

    Serial.println("No echo");

  } else {

    float distance = duration * 0.0343 / 2.0;

    Serial.print("Distance: ");

    Serial.print(distance);

    Serial.println(" cm");

  }

  delay(200);

}

تحلیل عملکرد

۱. میکروکنترلر یک پالس کوتاه روی پایه TRIG ایجاد می‌کند.

۲. حسگر موج فراصوت را ارسال می‌کند.

۳. موج به مانع برخورد کرده و بازمی‌گردد.

۴. حسگر مدت زمان بازگشت موج را از طریق پایه ECHO مشخص می‌کند.

۵. برنامه با استفاده از زمان اندازه‌گیری‌شده، فاصله را محاسبه می‌کند.

فرمول محاسبه فاصله:

فاصله = (زمان × سرعت صوت) ÷ ۲

تقسیم بر دو به این دلیل است که موج مسیر رفت و برگشت را طی کرده است.

تمرین

اگر فاصله کمتر از ۲۰ سانتی‌متر شد، یک LED هشدار را روشن کنید.

